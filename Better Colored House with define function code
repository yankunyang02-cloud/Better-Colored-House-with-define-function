def gate_beige():
    t.pendown()
    t.fillcolor("beige")
    t.begin_fill()
    t.setheading(90)
    for _ in range(30):
            t.forward(70)
            t.right(90)
            t.forward(20)
            t.right(90)
            t.forward(70)
            t.left(90)
            t.forward(20)
            t.left(90)


gate_beige()
